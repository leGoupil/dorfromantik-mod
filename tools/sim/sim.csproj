<!-- Simulateur hors jeu : rejoue des parties avec le modèle et le solveur du mod. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>dorfsim</AssemblyName>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Code partagé avec le mod (sans dépendance à Unity) -->
    <Compile Include="../../src/DorfHelper/Model/Board.cs" Link="Shared/Board.cs" />
    <Compile Include="../../src/DorfHelper/Model/GameSnapshot.cs" Link="Shared/GameSnapshot.cs" />
    <Compile Include="../../src/DorfHelper/Solver.cs" Link="Shared/Solver.cs" />
  </ItemGroup>
</Project>
