<!-- Offline simulator: replays games using the mod's model and solver. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>dorfsim</AssemblyName>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Code shared with the mod (no Unity dependency) -->
    <Compile Include="../../src/DorfHelper/Model/Board.cs" Link="Shared/Board.cs" />
    <Compile Include="../../src/DorfHelper/Model/GameSnapshot.cs" Link="Shared/GameSnapshot.cs" />
    <Compile Include="../../src/DorfHelper/Solver.cs" Link="Shared/Solver.cs" />
  </ItemGroup>
</Project>
